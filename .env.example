# For local testing, leave DATABASE_URL empty.
# For public hosting with persistent data, set a PostgreSQL connection string.
DATABASE_URL=

# Optional: only used when the admin account is first created.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-public-launch

# Optional local/paid-volume data directory when DATABASE_URL is not used.
# CAMPUSBITE_DATA_DIR=./data
